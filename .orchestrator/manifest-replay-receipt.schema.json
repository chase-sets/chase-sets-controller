{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "host-heavy-manifest-replay/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "runId", "phase", "lane", "worktree", "head", "identityMode", "branch", "package", "executable", "arguments", "child", "slot", "lockId", "executionStarted", "startedUtc", "endedUtc", "elapsedMs", "budgetSeconds", "callBudgetSeconds", "exit", "nativeExit", "outcome", "reason", "result", "resultSha256", "firstFailure", "logs", "recorderComplete", "survivorsAtExit", "survivorsAfterCleanup", "cleanupComplete", "released", "releasedUtc", "attemptConsumed", "baseReceiptSha256", "results", "pairComplete"],
  "properties": {
    "schema": {"const": "host-heavy-manifest-replay/v1"},
    "runId": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "phase": {"enum": ["base", "repaired"]},
    "lane": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "worktree": {"type": "string", "maxLength": 1024}, "head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "identityMode": {"enum": ["branch", "immutable-head"]}, "branch": {"type": ["string", "null"]},
    "package": {
      "type": "object", "additionalProperties": false, "required": ["declarationSha256", "bindingsSha256", "controllerPins", "pins"],
      "properties": {
        "declarationSha256": {"$ref": "#/definitions/hash"}, "bindingsSha256": {"$ref": "#/definitions/hash"},
        "controllerPins": {"type": "object", "minProperties": 5, "maxProperties": 8, "additionalProperties": {"$ref": "#/definitions/hash"}},
        "pins": {"type": "object", "minProperties": 5, "maxProperties": 143, "additionalProperties": {"$ref": "#/definitions/hash"}}
      }
    },
    "executable": {"type": "string", "maxLength": 1024}, "arguments": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "maxLength": 1024}},
    "child": {"type": ["object", "null"], "additionalProperties": false, "required": ["pid", "processStartUtc"], "properties": {"pid": {"type": "integer", "minimum": 1}, "processStartUtc": {"type": "string"}}},
    "slot": {"const": "verify-lock.d"}, "lockId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "executionStarted": {"type": ["boolean", "null"]}, "startedUtc": {"type": ["string", "null"]}, "endedUtc": {"type": "string"},
    "elapsedMs": {"type": "integer", "minimum": 0, "maximum": 600000}, "budgetSeconds": {"const": 540}, "callBudgetSeconds": {"const": 600},
    "exit": {"enum": [0, 1, 73, 124]}, "nativeExit": {"type": ["integer", "null"]},
    "outcome": {"enum": ["not-executed", "expected-failure", "passed", "failed", "incomplete", "timed-out"]},
    "reason": {"type": "string", "maxLength": 2048},
    "result": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/phaseResult"}]}, "resultSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/hash"}]},
    "firstFailure": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/firstFailure"}]},
    "logs": {
      "type": "object", "additionalProperties": false, "required": ["stdout", "stderr"],
      "properties": {"stdout": {"$ref": "#/definitions/log"}, "stderr": {"$ref": "#/definitions/log"}}
    },
    "recorderComplete": {"type": "boolean"}, "survivorsAtExit": {"type": ["integer", "null"], "minimum": 0},
    "survivorsAfterCleanup": {"type": ["integer", "null"], "minimum": 0}, "cleanupComplete": {"type": "boolean"},
    "released": {"type": "boolean"}, "releasedUtc": {"type": ["string", "null"]}, "attemptConsumed": {"type": ["boolean", "null"]},
    "baseReceiptSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/hash"}]},
    "results": {"type": "object", "additionalProperties": false, "required": ["base", "repaired"], "properties": {"base": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/phaseResult"}]}, "repaired": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/phaseResult"}]}}},
    "pairComplete": {"type": "boolean"}
  },
  "definitions": {
    "phaseResult": {
      "type": "object", "additionalProperties": false, "required": ["schema", "runId", "phase", "head", "nativeExit", "status", "checks"],
      "properties": {
        "schema": {"const": "host-heavy-replay-phase-result/v1"}, "runId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "phase": {"enum": ["base", "repaired"]}, "head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "nativeExit": {"type": "integer"}, "status": {"enum": ["passed", "failed"]},
        "checks": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["stage", "status", "code", "message"], "properties": {"stage": {"type": "string", "minLength": 1, "maxLength": 128}, "status": {"enum": ["passed", "failed"]}, "code": {"type": "string", "minLength": 1, "maxLength": 128}, "message": {"type": "string", "maxLength": 2048}}}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"nativeExit": {"const": 0}, "checks": {"items": {"properties": {"status": {"const": "passed"}}}}}}, "else": {"properties": {"nativeExit": {"not": {"enum": [0, 73, 124]}}, "checks": {"contains": {"properties": {"status": {"const": "failed"}}}}}}},
        {"if": {"properties": {"phase": {"const": "repaired"}, "status": {"const": "passed"}}}, "then": {"properties": {"checks": {"allOf": [{"contains": {"properties": {"stage": {"const": "identity"}, "status": {"const": "passed"}}}}, {"contains": {"properties": {"stage": {"const": "content"}, "status": {"const": "passed"}}}}]}}}}
      ]
    },
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "firstFailure": {"type": "object", "additionalProperties": false, "required": ["stage", "code", "message"], "properties": {"stage": {"type": "string", "minLength": 1, "maxLength": 128}, "code": {"type": "string", "minLength": 1, "maxLength": 128}, "message": {"type": "string", "maxLength": 2048}}},
    "log": {"type": ["object", "null"], "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "maxLength": 1024}, "bytes": {"type": "integer", "minimum": 0, "maximum": 8388608}, "sha256": {"$ref": "#/definitions/hash"}}}
  },
  "allOf": [
    {"if": {"properties": {"nativeExit": {"const": 73}}}, "then": {"properties": {"attemptConsumed": {"const": false}, "pairComplete": {"const": false}, "exit": {"enum": [1, 73, 124]}}}},
    {"if": {"properties": {"exit": {"const": 73}}}, "then": {"properties": {"outcome": {"const": "not-executed"}, "attemptConsumed": {"const": false}, "pairComplete": {"const": false}}}},
    {"if": {"properties": {"exit": {"const": 124}}}, "then": {"properties": {"outcome": {"const": "timed-out"}, "pairComplete": {"const": false}}}},
    {"if": {"properties": {"exit": {"const": 1}}}, "then": {"properties": {"outcome": {"enum": ["incomplete", "failed"]}, "pairComplete": {"const": false}}}},
    {"if": {"properties": {"exit": {"const": 0}}}, "then": {"properties": {"executionStarted": {"const": true}, "attemptConsumed": {"const": true}, "recorderComplete": {"const": true}, "cleanupComplete": {"const": true}, "released": {"const": true}, "releasedUtc": {"type": "string"}, "survivorsAtExit": {"const": 0}, "survivorsAfterCleanup": {"const": 0}, "result": {"type": "object"}, "resultSha256": {"$ref": "#/definitions/hash"}, "outcome": {"enum": ["expected-failure", "passed"]}}}},
    {"if": {"properties": {"outcome": {"const": "expected-failure"}}}, "then": {"properties": {"phase": {"const": "base"}, "exit": {"const": 0}, "nativeExit": {"type": "integer", "not": {"enum": [0, 73, 124]}}, "firstFailure": {"type": "object"}, "pairComplete": {"const": false}}}},
    {"if": {"properties": {"outcome": {"const": "passed"}}}, "then": {"properties": {"phase": {"const": "repaired"}, "exit": {"const": 0}, "nativeExit": {"const": 0}, "firstFailure": {"const": null}, "pairComplete": {"const": true}, "baseReceiptSha256": {"$ref": "#/definitions/hash"}, "results": {"properties": {"base": {"type": "object"}, "repaired": {"type": "object"}}}}}},
    {"if": {"properties": {"pairComplete": {"const": true}}}, "then": {"properties": {"outcome": {"const": "passed"}}}},
    {"if": {"properties": {"executionStarted": {"const": false}}}, "then": {"properties": {"attemptConsumed": {"const": false}, "nativeExit": {"const": null}}}},
    {"if": {"properties": {"released": {"const": false}}}, "then": {"properties": {"releasedUtc": {"const": null}, "exit": {"enum": [1, 124]}}}}
  ]
}
