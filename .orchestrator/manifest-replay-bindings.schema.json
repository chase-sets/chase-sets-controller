{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "host-heavy-manifest-replay-bindings/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "runId", "head", "worktree", "budgetSeconds", "provenance", "phases"],
  "properties": {
    "schema": {"const": "host-heavy-manifest-replay-bindings/v1"},
    "runId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "worktree": {"type": "string", "minLength": 4, "maxLength": 1024},
    "budgetSeconds": {"const": 540},
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["manifest", "artifacts"],
      "properties": {
        "manifest": {"$ref": "#/definitions/pin"},
        "artifacts": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/definitions/pin"}}
      }
    },
    "phases": {
      "type": "object", "additionalProperties": false, "required": ["base", "repaired"],
      "properties": {
        "base": {"allOf": [{"$ref": "#/definitions/phase"}, {"properties": {"expected": {"properties": {"nativeExit": {"not": {"enum": [0, 73, 124]}}, "firstFailure": {"$ref": "#/definitions/firstFailure"}}}}}]},
        "repaired": {"allOf": [{"$ref": "#/definitions/phase"}, {"properties": {"expected": {"properties": {"nativeExit": {"const": 0}, "firstFailure": {"type": "null"}}}}}]}
      }
    }
  },
  "definitions": {
    "pin": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "maxLength": 1024, "pattern": "^\\.orchestrator/logs/[A-Za-z0-9_/-][A-Za-z0-9._/-]*$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "firstFailure": {
      "type": "object", "additionalProperties": false, "required": ["stage", "code", "message"],
      "properties": {
        "stage": {"type": "string", "minLength": 1, "maxLength": 128},
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "message": {"type": "string", "maxLength": 2048}
      }
    },
    "phase": {
      "type": "object", "additionalProperties": false,
      "required": ["wrapper", "spec", "capture", "preflight", "dependencies", "command", "invocation", "resultPath", "expected"],
      "properties": {
        "wrapper": {"$ref": "#/definitions/pin"}, "spec": {"$ref": "#/definitions/pin"},
        "capture": {"$ref": "#/definitions/pin"}, "preflight": {"$ref": "#/definitions/pin"},
        "dependencies": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/definitions/pin"}},
        "command": {
          "type": "object", "additionalProperties": false, "required": ["executable", "arguments"],
          "properties": {
            "executable": {"const": "pwsh"},
            "arguments": {"type": "array", "minItems": 5, "maxItems": 5, "items": [{"const": "-NoProfile"}, {"const": "-File"}, {"type": "string"}, {"const": "-Spec"}, {"type": "string"}]}
          }
        },
        "invocation": {
          "type": "object", "additionalProperties": false, "required": ["executable", "arguments"],
          "properties": {
            "executable": {"const": "node"},
            "arguments": {"type": "array", "minItems": 2, "maxItems": 2, "items": [{"type": "string"}, {"const": "step3"}]}
          }
        },
        "resultPath": {"type": "string", "maxLength": 1024},
        "expected": {
          "type": "object", "additionalProperties": false, "required": ["nativeExit", "firstFailure"],
          "properties": {"nativeExit": {"type": "integer"}, "firstFailure": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/firstFailure"}]}}
        }
      }
    },
    "phaseResult": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "runId", "phase", "head", "nativeExit", "status", "checks"],
      "properties": {
        "schema": {"const": "host-heavy-replay-phase-result/v1"},
        "runId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "phase": {"enum": ["base", "repaired"]},
        "head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "nativeExit": {"type": "integer"}, "status": {"enum": ["passed", "failed"]},
        "checks": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["stage", "status", "code", "message"],
            "properties": {
              "stage": {"type": "string", "minLength": 1, "maxLength": 128},
              "status": {"enum": ["passed", "failed"]},
              "code": {"type": "string", "minLength": 1, "maxLength": 128},
              "message": {"type": "string", "maxLength": 2048}
            }
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"nativeExit": {"const": 0}, "checks": {"items": {"properties": {"status": {"const": "passed"}}}}}}, "else": {"properties": {"nativeExit": {"not": {"enum": [0, 73, 124]}}, "checks": {"contains": {"properties": {"status": {"const": "failed"}}}}}}},
        {"if": {"properties": {"phase": {"const": "repaired"}, "status": {"const": "passed"}}}, "then": {"properties": {"checks": {"allOf": [{"contains": {"properties": {"stage": {"const": "identity"}, "status": {"const": "passed"}}}}, {"contains": {"properties": {"stage": {"const": "content"}, "status": {"const": "passed"}}}}]}}}}
      ]
    }
  }
}
